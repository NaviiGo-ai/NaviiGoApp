# ─────────────────────────────────────────────────────────────────────────────
# NAVIIGO MOBILE — ENVIRONMENT CONFIGURATION TEMPLATE
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT SECURITY NOTICE:
# - Server-side secrets (GEMINI_API_KEY, SERPAPI_API_KEY, GOOGLE_PLACES_SECRET,
#   RAZORPAY_SECRET_KEY, FIREBASE_ADMIN_CREDENTIALS) must NEVER be placed here
#   or in any Flutter client file. They remain secured on the Render backend.
# - Only client-safe configurations and native SDK keys restricted by platform
#   (Android package name + SHA-1 fingerprint / iOS bundle ID) belong here.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API Configuration
API_ENV=production
API_BASE_URL=https://naviigo-website.onrender.com
API_CONNECT_TIMEOUT_MS=15000
API_RECEIVE_TIMEOUT_MS=25000

# Firebase Platform Settings
FIREBASE_PROJECT_ID=naviigo-firebase
FIRESTORE_DATABASE_ID=naviigo-db

# Google Maps Native Mobile SDK Keys (Restricted to Android package & iOS Bundle ID)
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
